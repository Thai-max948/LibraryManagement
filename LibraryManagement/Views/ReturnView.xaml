<UserControl x:Class="LibraryManagement.Views.ReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels">

    <StackPanel Margin="10">
        <TextBlock Text="↩ Return Book" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"
                 Tag="Search reader / book..."
                 Style="{StaticResource PlaceholderTextBoxStyle}"/>

        <TextBlock Text="Active Borrowings" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
        <DataGrid ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource AppDataGridStyle}" Height="360" Margin="0,0,0,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reader" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Book" Binding="{Binding BookTitle}" Width="*"/>
                <DataGridTextColumn Header="Borrow Date" Binding="{Binding BorrowDate}" Width="120"/>
                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="{Binding SelectedRow.BookTitle, StringFormat='Selected: {0}'}"
                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

        <Button Content="↩ Return Book" Command="{Binding ReturnCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                HorizontalAlignment="Right"/>
    </StackPanel>
</UserControl>