<Window x:Class="LibraryManagement.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LibraryManagement.ViewModels"
        xmlns:views="clr-namespace:LibraryManagement.Views"
        Title="Library Management System" Height="700" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tech Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource TechBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="16,22,16,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" Background="#0C2540" CornerRadius="6" BorderBrush="{StaticResource TechAccentCyan}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LIBRARY OS" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="SYSTEM CORE" Foreground="{StaticResource TechAccentCyan}" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="NAVIGATION" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="16,0,0,8"/>
                    <Button Content="📊  Dashboard" Command="{Binding ShowDashboardCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="📚  Books"     Command="{Binding ShowBooksCommand}"     Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="👥  Readers"   Command="{Binding ShowReadersCommand}"   Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="📖  Borrow"    Command="{Binding ShowBorrowCommand}"    Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="↩  Return"     Command="{Binding ShowReturnCommand}"    Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="📋  History"       Command="{Binding ShowHistoryCommand}"   Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="💰  Fees"          Command="{Binding ShowFeesCommand}"      Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="👤  My Account"    Command="{Binding ShowMyAccountCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="⚙  User Accounts" Command="{Binding ShowAccountsCommand}"  Style="{StaticResource SidebarButtonStyle}" Visibility="{Binding AccountsVisibility}"/>
                </StackPanel>

                <!-- Footer Status Indicator & Logout -->
                <StackPanel Grid.Row="2" Margin="14,14">
                    <Border Padding="12,10" Background="#0A111E" CornerRadius="6" BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource TechAccentCyan}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CurrentUserName}" Foreground="{StaticResource TechAccentCyan}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentUserRole}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="12,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🚪  Sign Out / Switch" Click="BtnLogout_Click" Style="{StaticResource SidebarButtonStyle}" Margin="0,6,0,0" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Button Grid.Row="0" Command="{Binding Notifications.ToggleCenterCommand}" HorizontalAlignment="Right" Margin="0,6,20,0"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" ToolTip="Mở thông báo">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔔" FontSize="16"/>
                    <Border Background="{StaticResource DangerBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Notifications.HasUnread}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding Notifications.UnreadCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Button>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="20,0,20,20"/>
            <views:NotificationCenterView Grid.RowSpan="2" Width="370" HorizontalAlignment="Right" DataContext="{Binding Notifications}" Panel.ZIndex="2">
                <views:NotificationCenterView.Style><Style TargetType="views:NotificationCenterView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCenterOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:NotificationCenterView.Style>
            </views:NotificationCenterView>
            <views:NotificationToastView Grid.RowSpan="2" Width="320" Margin="0,0,20,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" DataContext="{Binding Notifications}" Panel.ZIndex="3">
                <views:NotificationToastView.Style><Style TargetType="views:NotificationToastView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsToastVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:NotificationToastView.Style>
            </views:NotificationToastView>
        </Grid>
    </Grid>
</Window>
