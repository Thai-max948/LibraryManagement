<UserControl x:Class="LibraryManagement.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels">

    <StackPanel Margin="10">
        <!-- Title and Overdue Quick Filter Card -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="📋 Borrowing History" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Command="{Binding FilterOverdueCommand}"
                    Cursor="Hand"
                    Padding="12,6"
                    ToolTip="Nhấn để lọc nhanh các sách đang quá hạn">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="{StaticResource TechBorderBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                <Setter Property="Background" Value="#FFE4E6"/>
                                <Setter Property="BorderBrush" Value="#FECDD3"/>
                                <Setter Property="Foreground" Value="{StaticResource TechAccentRose}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OverdueCount, StringFormat='{}{0} Overdue'}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search reader / book / barcode..."
                     Style="{StaticResource PlaceholderTextBoxStyle}"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Padding="6"/>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="From" Foreground="{StaticResource TextBrush}"/>
                <DatePicker SelectedDate="{Binding FromDate}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="To" Foreground="{StaticResource TextBrush}"/>
                <DatePicker SelectedDate="{Binding ToDate}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TechAccentRose}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource AppDataGridStyle}" Height="330">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reader" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Book" Binding="{Binding BookTitle}" Width="*"/>
                <DataGridTextColumn Header="Copy / Barcode" Binding="{Binding CopyLabel}" Width="170"/>
                <DataGridTextColumn Header="Borrow" Binding="{Binding BorrowDate}" Width="100"/>
                <DataGridTextColumn Header="Due" Binding="{Binding DueDate}" Width="100"/>
                <DataGridTextColumn Header="Return" Binding="{Binding ReturnDate}" Width="100"/>
                <DataGridTemplateColumn Header="Status" Width="180" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="{Binding OverdueText}">
                                <TextBlock x:Name="StatusText" Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Returned">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TechAccentGreen}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Borrowing">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#E0F2FE"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TechAccentCyan}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#FFE4E6"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TechAccentRose}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Lost">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#FFE4E6"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TechAccentRose}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="10,5" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Content="Next ›" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Padding="12,5"/>
            <Button DockPanel.Dock="Right" Content="‹ Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" Padding="12,5" Margin="0,0,8,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>

        <Border Margin="0,12,0,0" Padding="12" CornerRadius="6"
                Background="#F8FAFC" BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Circulation events" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding SelectedRecord.AuditTimeline, TargetNullValue='Select a record to view its events.'}"
                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
