<UserControl x:Class="LibraryManagement.Views.Books.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels"
             xmlns:models="clr-namespace:LibraryManagement.Models">

    <StackPanel Margin="10">
        <TextBlock Text="📚 Books Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Manage your library collection" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

        <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalBooks}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Books" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalAvailable}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Available" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalBorrowed}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Borrowed" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Margin="0,0,0,10">
            <ComboBox Width="145" DockPanel.Dock="Right" Margin="8,0,0,0"
                      ItemsSource="{x:Static models:LanguageCatalog.FilterOptions}"
                      DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                      SelectedValue="{Binding LanguageFilter, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Filter by language">
            </ComboBox>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search title / author / ISBN / publisher..."
                     Style="{StaticResource PlaceholderTextBoxStyle}"/>
        </DockPanel>

        <CheckBox Content="Show archived books" IsChecked="{Binding ShowArchived}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Add Book" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="View detail" Click="ViewDetail_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="✏ Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Archive" Command="{Binding ArchiveCommand}" Style="{StaticResource DangerButtonStyle}"/>
            <Button Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="📦 Manage Copies" Click="ManageCopies_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Đối soát tồn kho" Click="InventoryCheck_Click" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}"
                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="62"
                  Style="{StaticResource AppDataGridStyle}" Height="380">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="50"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220" MinWidth="180"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="130"/>
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="150"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140"/>
                <DataGridTextColumn Header="Language" Binding="{Binding LanguageDisplay}" Width="110"/>
                <DataGridTextColumn Header="Year" Binding="{Binding PublishYear}" Width="70"/>
                <DataGridTemplateColumn Header="Pricing" Width="190" MinWidth="175">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="BookPriceValue"
                                           Text="{Binding ReplacementValue, StringFormat={}{0:C2}, ConverterCulture=en-US}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <StackPanel x:Name="RentalPriceDetails" Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="Rent" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RentalPrice, StringFormat={}{0:C2}, ConverterCulture=en-US, TargetNullValue=—}"
                                               FontSize="11" Foreground="{StaticResource TechAccentGreen}" Margin="5,0,7,0" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource BookPricingBadgeStyle}">
                                        <TextBlock Text="{Binding DataContext.PricingRateBadge, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                   Style="{StaticResource BookPricingBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="NotConfigured" Grid.Row="1" Text="Not configured" Margin="0,3,0,0"
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ReplacementValue}" Value="{x:Null}">
                                    <Setter TargetName="BookPriceValue" Property="TextBlock.Text" Value="—"/>
                                    <Setter TargetName="RentalPriceDetails" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="NotConfigured" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
