<UserControl x:Class="LibraryManagement.Views.Books.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:books="clr-namespace:LibraryManagement.Views.Books">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📚 Books Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Manage your library collection" Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalBooks}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Books" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalAvailable}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Available" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalBorrowed}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Borrowed" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search title / author / ISBN / publisher..."
                     Style="{StaticResource PlaceholderTextBoxStyle}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FilterButton" Content="{Binding FilterButtonText}" Click="ToggleFilters_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,14,0"/>
                <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox Width="160" ItemsSource="{Binding SortOptions}"
                          DisplayMemberPath="Label" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                          VerticalContentAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox Width="160" ItemsSource="{Binding ViewScopeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding ViewScope, Mode=TwoWay}" VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Height="52" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
            <ItemsControl ItemsSource="{Binding ActiveFilterChips}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#E0F2FE" CornerRadius="12" Margin="0,0,6,0">
                            <Button Content="{Binding Label, StringFormat={}{0} ×}"
                                    Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding Key}" Padding="10,4" BorderThickness="0"
                                    Background="Transparent" Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="+ Add Book" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="View detail" Click="ViewDetail_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="✏ Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Archive" Command="{Binding ArchiveCommand}" Style="{StaticResource DangerButtonStyle}"/>
            <Button Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="📦 Manage Copies" Click="ManageCopies_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Đối soát tồn kho" Click="InventoryCheck_Click" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ResultCountText}" Margin="0,0,0,6"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}"
                      AutoGenerateColumns="False" IsReadOnly="True" RowHeight="62" MinHeight="180"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="50"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220" MinWidth="180"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="130"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="150"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140"/>
                    <DataGridTextColumn Header="Language" Binding="{Binding LanguageDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Year" Binding="{Binding PublishYear}" Width="70"/>
                    <DataGridTemplateColumn Header="Pricing" Width="190" MinWidth="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="BookPriceValue"
                                               Text="{Binding ReplacementValue, StringFormat={}{0:C2}, ConverterCulture=en-US}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <StackPanel x:Name="RentalPriceDetails" Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="Rent" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RentalPrice, StringFormat={}{0:C2}, ConverterCulture=en-US, TargetNullValue=—}"
                                                   FontSize="11" Foreground="{StaticResource TechAccentGreen}" Margin="5,0,7,0" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource BookPricingBadgeStyle}">
                                            <TextBlock Text="{Binding DataContext.PricingRateBadge, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                       Style="{StaticResource BookPricingBadgeTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="NotConfigured" Grid.Row="1" Text="Not configured" Margin="0,3,0,0"
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ReplacementValue}" Value="{x:Null}">
                                        <Setter TargetName="BookPriceValue" Property="TextBlock.Text" Value="—"/>
                                        <Setter TargetName="RentalPriceDetails" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="NotConfigured" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource TechBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No books match the current search and filters." FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="0,12,0,0"
                            HorizontalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource TechBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="15" Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"/>
                    <Button Content="Retry" Command="{Binding RetryCommand}" Margin="0,12,0,0"
                            HorizontalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding RangeSummary}" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Page size" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ComboBox Width="72" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}"
                              VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"/>
                    <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextBrush}"/>
                    <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Popup PlacementTarget="{Binding ElementName=FilterButton}"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom"
               IsOpen="{Binding IsFilterPanelOpen, Mode=TwoWay}" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="640" MaxHeight="540" Padding="16" CornerRadius="10"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource TechBorderBrush}"
                    BorderThickness="1" PreviewKeyDown="FilterPopup_PreviewKeyDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="508">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Category" Style="{StaticResource BookFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding CategoryFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding CategoryFilter, Mode=TwoWay}" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Author" Style="{StaticResource BookFieldLabelStyle}"/>
                            <ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="190"
                                      ItemsSource="{Binding AuthorFilterOptions}" Text="{Binding AuthorFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Tag="All authors · type to search" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Language" Style="{StaticResource BookFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding LanguageFilterOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                      SelectedValue="{Binding LanguageCodeFilter, Mode=TwoWay}" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Publisher" Style="{StaticResource BookFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PublisherFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding PublisherFilter, Mode=TwoWay}" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Publish Year From" Style="{StaticResource BookFieldLabelStyle}"/>
                            <TextBox Text="{Binding PublishYearFromText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Any year" Style="{StaticResource PlaceholderTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Publish Year To" Style="{StaticResource BookFieldLabelStyle}"/>
                            <TextBox Text="{Binding PublishYearToText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Any year" Style="{StaticResource PlaceholderTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Book Price Range" Style="{StaticResource BookFieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="$" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBox Text="{Binding MinBookPriceText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Min price" Style="{StaticResource PlaceholderTextBoxStyle}"
                                             Width="250"
                                             IsEnabled="{Binding HasConfiguredBookPrices}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="12,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="$" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBox Text="{Binding MaxBookPriceText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Max price" Style="{StaticResource PlaceholderTextBoxStyle}"
                                             Width="250"
                                             IsEnabled="{Binding HasConfiguredBookPrices}"/>
                                </StackPanel>
                            </Grid>
                            <books:RangeSlider Margin="0,5,0,0"
                                               Minimum="{Binding PriceSliderMinimum}"
                                               Maximum="{Binding PriceSliderMaximum}"
                                               LowerValue="{Binding PriceSliderLowerValue, Mode=TwoWay}"
                                               UpperValue="{Binding PriceSliderUpperValue, Mode=TwoWay}"
                                               SmallChange="{Binding PriceSliderSmallChange}"
                                               IsEnabled="{Binding HasConfiguredBookPrices}"/>
                            <TextBlock Text="{Binding NoConfiguredPricesText}" Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConfiguredBookPrices}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ValidationMessage}"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Apply filters" Command="{Binding ApplyFiltersCommand}"
                                    IsEnabled="{Binding CanApplyFilters}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
