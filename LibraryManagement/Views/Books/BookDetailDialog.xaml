<Window x:Class="LibraryManagement.Views.Books.BookDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book detail" Height="820" Width="1040" MinHeight="680" MinWidth="840"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}" ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource BookPanelStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding CurrentBook.Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding CurrentBook.BookId, StringFormat=Book ID: {0}}" Margin="0,0,22,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CurrentBook.Author, StringFormat=Author: {0}}" Margin="0,0,22,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CurrentBook.Isbn, TargetNullValue=ISBN: —, StringFormat=ISBN: {0}}" Margin="0,0,22,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CurrentBook.Category, StringFormat=Category: {0}}" Margin="0,0,22,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CurrentBook.Publisher, StringFormat=Publisher: {0}}" Margin="0,0,22,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CurrentBook.LanguageDisplay, StringFormat=Language: {0}}" Margin="0,0,22,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CurrentBook.PublishYear, StringFormat=Year: {0}}" Margin="0,0,22,5" Foreground="{StaticResource SecondaryTextBrush}"/>
                </WrapPanel>
                <WrapPanel Margin="0,3,0,0">
                    <TextBlock Text="Record (UTC)" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding CurrentBook.CreatedAt, StringFormat=Created: {0:yyyy-MM-dd HH:mm}, TargetNullValue=Created: Not recorded}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding CurrentBook.UpdatedAt, StringFormat=Updated: {0:yyyy-MM-dd HH:mm}, TargetNullValue=Updated: Never}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding CurrentBook.ArchivedAt, StringFormat=Archived: {0:yyyy-MM-dd HH:mm}}" Foreground="{StaticResource SecondaryTextBrush}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Edit book" Click="Edit_Click" IsEnabled="{Binding CanManage}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Archive" Click="Archive_Click" IsEnabled="{Binding CanManage}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Restore" Click="Restore_Click" IsEnabled="{Binding IsArchived}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource BookPanelStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PRICING" Style="{StaticResource BookSectionTitleStyle}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Book Value" Style="{StaticResource BookFieldLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentBook.ReplacementValue, StringFormat={}{0:C2}, ConverterCulture=en-US, TargetNullValue=Not configured}"
                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Rental Price" Style="{StaticResource BookFieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentBook.RentalPrice, StringFormat={}{0:C2}, ConverterCulture=en-US, TargetNullValue=Not configured}"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TechAccentGreen}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource BookPricingBadgeStyle}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding PricingPolicy.RentalRate, StringFormat='AUTO · {0:P0}', ConverterCulture=en-US}"
                                           Style="{StaticResource BookPricingBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource BookPanelStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="INVENTORY &amp; STATUS" Style="{StaticResource BookSectionTitleStyle}" Margin="0,0,0,8"/>
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,2,8,2">
                        <TextBlock Text="Book status" Style="{StaticResource BookFieldLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentBook.Status}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Inventory.TotalCopies, StringFormat=Total copies: {0}}" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Inventory.ActiveCopies, StringFormat=Active: {0}}" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Inventory.Available, StringFormat=Available: {0}}" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Inventory.Borrowed, StringFormat=Borrowed: {0}}" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Inventory.DamagedUnderRepair, StringFormat=Damaged / under repair: {0}}" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Inventory.Lost, StringFormat=Lost: {0}}" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Inventory.Retired, StringFormat=Retired: {0}}" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource BookPanelStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Physical Copies" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Manage copies" Click="ManageCopies_Click"
                            IsEnabled="{Binding CanManage}" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Copies}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              Style="{StaticResource AppDataGridStyle}" MinHeight="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="190"/>
                            <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="150"/>
                            <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No physical copies have been added yet." FontStyle="Italic" Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding HasNoCopies, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="Close" Click="Close_Click" DockPanel.Dock="Right" Padding="15,7" Style="{StaticResource SecondaryButtonStyle}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
