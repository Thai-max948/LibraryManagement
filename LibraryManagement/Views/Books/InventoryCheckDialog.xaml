<Window x:Class="LibraryManagement.Views.Books.InventoryCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đối soát tồn kho" Width="1000" Height="520" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Số lượng được tính từ từng bản sách. Tổng hiện tại gồm mọi trạng thái, kể cả bản hỏng và đã thanh lý. Báo cáo chỉ đọc, không tự sửa dữ liệu."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <DataGrid x:Name="ReportGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Book ID" Binding="{Binding BookId}" Width="65"/>
                <DataGridTextColumn Header="Đầu sách" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Tổng hiện tại" Binding="{Binding TotalCurrent}" Width="110"/>
                <DataGridTextColumn Header="Sẵn có hiện tại" Binding="{Binding AvailableCurrent}" Width="120"/>
                <DataGridTextColumn Header="Đang mượn" Binding="{Binding Borrowed}" Width="100"/>
                <DataGridTextColumn Header="Damaged\UnderRepair" Binding="{Binding DamagedUnderRepair}" Width="170"/>
                <DataGridTextColumn Header="Lost" Binding="{Binding Lost}" Width="75"/>
                <DataGridTextColumn Header="Retired" Binding="{Binding Retired}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
