<UserControl x:Class="LibraryManagement.Views.Books.RangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28" MinHeight="28" Focusable="False">
    <Canvas x:Name="SliderCanvas" Background="Transparent" SizeChanged="SliderCanvas_SizeChanged"
            MouseLeftButtonDown="SliderCanvas_MouseLeftButtonDown">
        <Border x:Name="Track" Height="4" Canvas.Top="12" CornerRadius="2"
                Background="{StaticResource TechBorderBrush}" IsHitTestVisible="False"/>
        <Border x:Name="SelectedTrack" Height="4" Canvas.Top="12" CornerRadius="2"
                Background="{StaticResource PrimaryBrush}" IsHitTestVisible="False"/>
        <Thumb x:Name="LowerThumb" Width="16" Height="16" Canvas.Top="6" DragDelta="LowerThumb_DragDelta"
               PreviewKeyDown="Thumb_PreviewKeyDown" Focusable="True" Cursor="Hand"
               AutomationProperties.Name="Minimum book price">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{StaticResource PrimaryBrush}" Stroke="White" StrokeThickness="2"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <Thumb x:Name="UpperThumb" Width="16" Height="16" Canvas.Top="6" DragDelta="UpperThumb_DragDelta"
               PreviewKeyDown="Thumb_PreviewKeyDown" Focusable="True" Cursor="Hand"
               AutomationProperties.Name="Maximum book price">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{StaticResource PrimaryBrush}" Stroke="White" StrokeThickness="2"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Canvas>
</UserControl>
