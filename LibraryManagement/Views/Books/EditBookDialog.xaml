<Window x:Class="LibraryManagement.Views.Books.EditBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LibraryManagement.Models"
        Title="Edit Book" Height="760" Width="560" MinHeight="610" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="EDIT BOOK" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Update title information and review its pricing" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="BOOK INFORMATION" Style="{StaticResource BookSectionTitleStyle}" Margin="0,0,0,10"/>

                <TextBlock Text="Title" Style="{StaticResource BookFieldLabelStyle}"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource BookFormTextBoxStyle}" Margin="0,0,0,12"/>

                <TextBlock Text="ISBN (optional)" Style="{StaticResource BookFieldLabelStyle}"/>
                <TextBox x:Name="IsbnBox" Style="{StaticResource BookFormTextBoxStyle}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Author" Style="{StaticResource BookFieldLabelStyle}"/>
                        <TextBox x:Name="AuthorBox" Style="{StaticResource BookFormTextBoxStyle}" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category" Style="{StaticResource BookFieldLabelStyle}"/>
                        <TextBox x:Name="CategoryBox" Style="{StaticResource BookFormTextBoxStyle}" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Publisher" Style="{StaticResource BookFieldLabelStyle}"/>
                        <TextBox x:Name="PublisherBox" Style="{StaticResource BookFormTextBoxStyle}" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Language (optional)" Style="{StaticResource BookFieldLabelStyle}"/>
                        <ComboBox x:Name="LanguageBox" IsEditable="True" TextSearch.TextPath="DisplayName" MinHeight="38" Padding="8,5" Margin="0,0,0,10"
                                  ItemsSource="{x:Static models:LanguageCatalog.BookOptions}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                  ToolTip="Choose a display name; the corresponding language code is saved"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Publish Year" Style="{StaticResource BookFieldLabelStyle}"/>
                        <TextBox x:Name="PublishYearBox" Style="{StaticResource BookFormTextBoxStyle}" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Active copies (Manage Copies to change)" TextWrapping="Wrap" Style="{StaticResource BookFieldLabelStyle}"/>
                        <TextBox x:Name="QuantityBox" Style="{StaticResource BookFormTextBoxStyle}" Margin="0,0,0,10" IsReadOnly="True" Background="{StaticResource BackgroundBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource BookPanelStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="PRICING" Style="{StaticResource BookSectionTitleStyle}"/>
                        <TextBlock Text="Rental price is calculated automatically from Book Price." Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Book Price" Style="{StaticResource BookFieldLabelStyle}"/>
                                <Grid>
                                    <TextBox x:Name="ReplacementValueBox" Style="{StaticResource BookPricingTextBoxStyle}"
                                             ToolTip="Current book value; nonnegative amount"/>
                                    <TextBlock Text="$">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BookPricingCurrencySymbolStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ReplacementValueBox}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="—">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BookPricingEmptyMarkerStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ReplacementValueBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rental Price" Style="{StaticResource BookFieldLabelStyle}"/>
                                <Grid>
                                    <TextBox x:Name="RentalPriceBox" Style="{StaticResource BookPricingReadOnlyTextBoxStyle}"
                                             ToolTip="Calculated from Book Price using the Book pricing policy"/>
                                    <TextBlock Text="$">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BookPricingCurrencySymbolStyle}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RentalPriceBox}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="—">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BookPricingEmptyMarkerStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RentalPriceBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,12,0,0" LastChildFill="False">
                            <Border DockPanel.Dock="Right" Style="{StaticResource BookPricingBadgeStyle}">
                                <TextBlock x:Name="PricingRateBadge" Style="{StaticResource BookPricingBadgeTextStyle}"/>
                            </Border>
                            <TextBlock Text="Automatically calculated" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </DockPanel>
                        <TextBlock x:Name="PricingPreviewText" Foreground="{StaticResource TechAccentGreen}" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Save Changes" Width="124" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
