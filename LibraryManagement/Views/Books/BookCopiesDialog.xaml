<Window x:Class="LibraryManagement.Views.Books.BookCopiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage copies" Height="640" Width="960" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource BookPanelStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="BookTitleText" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="InventoryText" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ArchivedNoticeText" Text="This book is archived. Restore it before managing copies."
                           Margin="0,5,0,0" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="CopiesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                  Style="{StaticResource AppDataGridStyle}" MinHeight="180"
                  SelectionChanged="CopiesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Copy ID" Binding="{Binding CopyId}" Width="85"/>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="190"/>
                <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="140"/>
                <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="175"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource BookPanelStyle}" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Quantity" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBox x:Name="QuantityBox" Grid.Column="1" Height="36" Padding="9,7" VerticalContentAlignment="Center"
                         ToolTip="Enter an integer from 1 to 100; barcodes are generated automatically" Margin="0,0,8,8"/>
                <Button x:Name="AddCopiesButton" Grid.Column="2" Content="Add copies" Click="AddCopy_Click"
                        IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,8"/>

                <TextBlock Grid.Row="1" Text="Actions" VerticalAlignment="Center" Margin="0,8,10,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                <Button x:Name="MarkAvailableButton" Grid.Row="1" Grid.Column="2" Content="Mark Available"
                        Click="MarkAvailable_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,8,0"/>
                <Button x:Name="RetireCopyButton" Grid.Row="1" Grid.Column="3" Content="Retire copy"
                        Click="RetireCopy_Click" IsEnabled="False" Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <Button Grid.Row="3" Content="Close" Click="Close_Click" HorizontalAlignment="Right"
                Margin="0,12,0,0" Padding="18,7" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
