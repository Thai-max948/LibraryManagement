<Window x:Class="LibraryManagement.Views.Books.BookCopiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý bản sách" Height="520" Width="820"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="BookTitleText" FontSize="20" FontWeight="Bold" Foreground="#172033"/>
            <TextBlock x:Name="InventoryText" Margin="0,4,0,0" Foreground="#526176"/>
        </StackPanel>
        <DataGrid x:Name="CopiesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Copy ID" Binding="{Binding CopyId}" Width="75"/>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="175"/>
                <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="110"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
            <TextBlock Text="Quantity" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="QuantityBox" Width="75" Height="34" Padding="8" VerticalContentAlignment="Center"
                     ToolTip="Nhập số nguyên từ 1 đến 100; barcode được tạo tự động"/>
            <Button x:Name="AddCopiesButton" Content="+ Add Copy" Click="AddCopy_Click" Margin="8,0,18,0" Padding="14,7"/>
            <ComboBox x:Name="StatusBox" Width="185" Height="34" VerticalContentAlignment="Center"/>
            <Button Content="Update Status" Click="UpdateStatus_Click" Margin="8,0,0,0" Padding="14,7"/>
        </WrapPanel>
        <Button Grid.Row="3" Content="Close" Click="Close_Click" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="18,7"/>
    </Grid>
</Window>
