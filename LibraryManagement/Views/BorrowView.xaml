<UserControl x:Class="LibraryManagement.Views.BorrowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="RecommendationItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource TechBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F9FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TechAccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StockBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableQuantity}" Value="0">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#FECACA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StockBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Text" Value="{Binding AvailableQuantity, StringFormat='🟢 Còn {0} cuốn'}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableQuantity}" Value="0">
                    <Setter Property="Foreground" Value="#DC2626"/>
                    <Setter Property="Text" Value="🔴 Hết sách"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <!-- Header -->
            <TextBlock Text="📖 Mượn Sách (Borrow Book)" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Tìm kiếm độc giả và sách với gợi ý thông minh thời gian thực" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,16"/>
            <!-- 2-Column Search & Recommendation Area -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT COLUMN: READER ==================== -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="👤 Độc Giả (Reader)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- State 1: Searching (when HasNoSelectedReader is True) -->
                        <StackPanel Visibility="{Binding HasNoSelectedReader, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding ReaderSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="🔍 Gõ tên, SĐT, email hoặc mã..."
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     FontSize="13"/>

                            <!-- Recommendations Container -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,8,0,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReaderRecommendationHeader}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="2,0,0,6"/>

                                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RecommendedReaders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectReaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RecommendationItemButtonStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock Text="{Binding Phone, StringFormat='📞 {0}'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding Email, StringFormat='✉ {0}'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" VerticalAlignment="Center" Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding ReaderId, StringFormat='#ID: {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TechAccentPurple}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- State 2: Reader Selected (when HasSelectedReader is True) -->
                        <Border Visibility="{Binding HasSelectedReader, Converter={StaticResource BoolToVis}}"
                                Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="✓ Độc giả đã chọn" Foreground="#16A34A" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedReader.ReaderId, StringFormat=' • Mã: #{0}'}" Foreground="#16A34A" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedReader.FullName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SelectedReader.Phone, StringFormat='📞 {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding SelectedReader.Email, StringFormat='✉ {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Content="🔄 Đổi độc giả"
                                        Command="{Binding ClearReaderSelectionCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6" FontSize="11.5"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ==================== RIGHT COLUMN: BOOK ==================== -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📚 Sách Mượn (Book)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- State 1: Searching (when HasNoSelectedBook is True) -->
                        <StackPanel Visibility="{Binding HasNoSelectedBook, Converter={StaticResource BoolToVis}}">
                            <TextBox x:Name="BookSearchInputBox"
                                     Text="{Binding BookSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="🔍 Gõ tên sách, tác giả, thể loại hoặc barcode..."
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     FontSize="13">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchBookInputCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1"
                                    CornerRadius="6" Padding="8,6" Margin="0,6,0,0"
                                    Visibility="{Binding HasBookSearchError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding BookSearchError}" Foreground="#BE123C" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Recommendations Container -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,8,0,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding BookRecommendationHeader}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="2,0,0,6"/>

                                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RecommendedBooks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RecommendationItemButtonStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="✍ " Foreground="#94A3B8"/>
                                                                    <Run Text="{Binding Author}"/>
                                                                    <Run Text="  •  "/>
                                                                    <Run Text="{Binding Category}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource StockBadgeBorderStyle}">
                                                                <TextBlock Style="{StaticResource StockBadgeTextStyle}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- State 2: Book Selected (when HasSelectedBook is True) -->
                        <Border Visibility="{Binding HasSelectedBook, Converter={StaticResource BoolToVis}}"
                                Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="✓ Sách đã chọn" Foreground="#16A34A" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedBook.BookId, StringFormat=' • Mã: #{0}'}" Foreground="#16A34A" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedBook.AvailableQuantity, StringFormat=' • Còn: {0} cuốn'}" Foreground="#16A34A" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedBook.Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0">
                                        <Run Text="Tác giả: "/>
                                        <Run Text="{Binding SelectedBook.Author}" FontWeight="SemiBold"/>
                                        <Run Text="  •  Thể loại: "/>
                                        <Run Text="{Binding SelectedBook.Category}"/>
                                    </TextBlock>
                                    <TextBlock Text="Bản sách / barcode cần cho mượn" Margin="0,10,0,4"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding AvailableCopies}"
                                              SelectedItem="{Binding SelectedCopy, Mode=TwoWay}"
                                              DisplayMemberPath="Barcode" Padding="6,4"/>
                                </StackPanel>

                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Content="🔄 Đổi sách"
                                        Command="{Binding ClearBookSelectionCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6" FontSize="11.5"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== BORROW DATES & ACTION ==================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PolicyPreview}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding EligibilityPreview}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="📖 Xác Nhận Mượn Sách"
                            Command="{Binding BorrowCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            VerticalAlignment="Bottom"
                            Height="34"
                            Padding="20,0"
                            Margin="0"/>
                </Grid>
            </Border>

            <!-- ==================== CURRENT BORROWINGS TABLE ==================== -->
            <TextBlock Text="📋 Danh Sách Đang Mượn (Current Borrowings)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding CurrentBorrowings}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource AppDataGridStyle}" MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Độc giả" Binding="{Binding ReaderName}" Width="*"/>
                    <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="1.4*"/>
                    <DataGridTextColumn Header="Ngày mượn" Binding="{Binding BorrowDate}" Width="130"/>
                    <DataGridTextColumn Header="Hạn trả" Binding="{Binding DueDate}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
