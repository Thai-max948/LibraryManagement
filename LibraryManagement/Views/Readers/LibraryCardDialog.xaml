<Window x:Class="LibraryManagement.Views.Readers.LibraryCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thẻ Thư Viện — Library Card" Height="530" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable Card Container -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,8,4">
            <Border CornerRadius="14" BorderThickness="1" BorderBrush="#CBD5E1" Margin="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#F8FAFC" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.10" BlurRadius="16" ShadowDepth="3"/>
                </Border.Effect>

                <Grid>
                    <!-- Top Card Header Accent Bar -->
                    <Border Height="8" VerticalAlignment="Top" CornerRadius="14,14,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0284C7" Offset="0.0"/>
                                <GradientStop Color="#06B6D4" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Margin="24,20,24,22">
                        <!-- Library Brand Header -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🏛️ UNIVERSITY LIBRARY"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#0284C7"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="MEMBERSHIP IDENTIFICATION CARD"
                                       FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Reader Name -->
                        <TextBlock x:Name="FullNameText"
                                   Text="Nguyễn Văn An"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <!-- Reader Type Badge -->
                        <Border x:Name="TypeBadge"
                                Background="#E0F2FE"
                                CornerRadius="12"
                                Padding="14,4"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="TypeText"
                                       Text="STUDENT"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#0369A1"/>
                        </Border>

                        <!-- Identification Info (Student ID or Identity Number) -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock x:Name="IdLabelText"
                                       Text="STUDENT ID"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="IdValueText"
                                       Text="23A12345"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- System Reader ID -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="SYSTEM READER ID"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ReaderIdText"
                                       Text="R000125"
                                       FontSize="18" FontWeight="ExtraBold"
                                       Foreground="#0F172A"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Status indicator -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="STATUS: " FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="StatusText" Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Close Button (Pinned at bottom) -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="0,12,0,0" Margin="0,8,0,0">
            <Button Content="Đóng Thẻ (Close)"
                    Width="150"
                    Height="36"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
