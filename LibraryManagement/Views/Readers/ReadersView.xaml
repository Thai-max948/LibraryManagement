<UserControl x:Class="LibraryManagement.Views.Readers.ReadersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels">

    <StackPanel Margin="10">
        <TextBlock Text="👥 Readers Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Manage library members" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding TotalReaders}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Readers" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"
                 Tag="Search name / phone / email..."
                 Style="{StaticResource PlaceholderTextBoxStyle}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Add Reader" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="✏ Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="🗑 Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource AppDataGridStyle}" Height="380">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ReaderId}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>