<Window x:Class="LibraryManagement.Views.Readers.AddReaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Reader" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="#FFFFFF" Margin="14" CornerRadius="8" Padding="20" BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="➕ Thêm Độc Giả Mới" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Chọn loại độc giả và nhập thông tin định danh" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                <Separator Background="#E2E8F0" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel Margin="0,4,0,10">
                    <!-- Reader Type Selection -->
                    <TextBlock Text="Loại độc giả (Reader Type)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="RadioStudent" Content="Sinh viên (Student)" IsChecked="True" Checked="ReaderType_Changed" Margin="0,0,24,0" FontWeight="Medium" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RadioExternal" Content="Người ngoài trường (External)" Checked="ReaderType_Changed" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Full Name -->
                    <TextBlock Text="Họ và tên (Full Name) *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="FullNameBox" Padding="8,6" Margin="0,0,0,12" BorderBrush="{StaticResource TechBorderBrush}"/>

                    <!-- Dynamic Identification: Student ID or Identity Number -->
                    <StackPanel x:Name="StudentIdPanel">
                        <TextBlock Text="Mã sinh viên (Student ID) *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="StudentIdBox" Padding="8,6" Margin="0,0,0,12" BorderBrush="{StaticResource TechBorderBrush}"/>
                    </StackPanel>

                    <StackPanel x:Name="IdentityNumberPanel" Visibility="Collapsed">
                        <TextBlock Text="Số CCCD / Định danh (Identity Number) *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="IdentityNumberBox" Padding="8,6" Margin="0,0,0,12" BorderBrush="{StaticResource TechBorderBrush}"/>
                    </StackPanel>

                    <!-- Phone & Email in 2 columns -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại (Phone) *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PhoneBox" Padding="8,6" BorderBrush="{StaticResource TechBorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EmailBox" Padding="8,6" BorderBrush="{StaticResource TechBorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Address -->
                    <TextBlock Text="Địa chỉ (Address)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="AddressBox" Padding="8,6" Margin="0,0,0,8" BorderBrush="{StaticResource TechBorderBrush}"/>
                    <TextBlock Text="Thẻ thư viện còn hiệu lực đến (để trống nếu chưa cấu hình)"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="MembershipExpiresOnPicker" Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Sticky Action Buttons -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="0,12,0,0" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Width="85" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="Thêm mới" Width="95" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
