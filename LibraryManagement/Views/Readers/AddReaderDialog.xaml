<Window x:Class="LibraryManagement.Views.Readers.AddReaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Reader" Height="260" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Full Name"/>
        <TextBox x:Name="FullNameBox" Margin="0,4,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Phone"/>
                <TextBox x:Name="PhoneBox" Margin="0,4,0,10"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Email"/>
                <TextBox x:Name="EmailBox" Margin="0,4,0,10"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>