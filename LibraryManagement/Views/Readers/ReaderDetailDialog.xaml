<Window x:Class="LibraryManagement.Views.Readers.ReaderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reader Details" Height="680" Width="780"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="📋 Hồ Sơ Độc Giả" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Thông tin cá nhân và toàn bộ hoạt động mượn trả" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,14"/>
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Reader ID" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Reader.FormattedId}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Loại độc giả" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Reader.ReaderType}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="Họ và tên" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Reader.FullName}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Mã SV / Định danh" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Reader.DisplayIdentification}"/>
                        <TextBlock Grid.Row="2" Text="Điện thoại" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Reader.Phone}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Email" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Reader.Email}"/>
                        <TextBlock Grid.Row="3" Text="Địa chỉ" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Reader.Address}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Text="Ngày đăng ký" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Reader.RegistrationDate, StringFormat=dd/MM/yyyy}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Trạng thái" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Reader.Status}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="5" Text="Lý do tạm khóa" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Reader.SuspensionReason}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Ngày tạm khóa" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding Reader.SuspendedDate, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=-}"/>
                    </Grid>
                </Border>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Đang mượn" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding CurrentlyBorrowing}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="Tổng lượt mượn" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding TotalBorrowed}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="Đang quá hạn" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding OverdueCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626"/></StackPanel></Border>
                </Grid>
                <TextBlock Text="Lịch sử mượn trả" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding BorrowingHistory}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridStyle}" MinHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã phiếu" Binding="{Binding BorrowId}" Width="75"/><DataGridTextColumn Header="Sách" Binding="{Binding BookTitle}" Width="*"/>
                        <DataGridTextColumn Header="Ngày mượn" Binding="{Binding BorrowDate, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Hạn trả" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Ngày trả" Binding="{Binding ReturnDate, StringFormat=dd/MM/yyyy, TargetNullValue=-}" Width="100"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="Đóng" Width="100" Height="34" HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
    </Grid>
</Window>
