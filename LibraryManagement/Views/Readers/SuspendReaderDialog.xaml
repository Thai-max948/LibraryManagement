<Window x:Class="LibraryManagement.Views.Readers.SuspendReaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạm khóa độc giả" Height="300" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="White" Margin="16" Padding="22" CornerRadius="10"
            BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Tạm khóa độc giả" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="ReaderText" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="Lý do tạm khóa *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="ReasonBox" MinHeight="82" Padding="9,7" TextWrapping="Wrap"
                         AcceptsReturn="True" BorderBrush="{StaticResource TechBorderBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy" Width="85" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Tạm khóa" Width="100" Style="{StaticResource PrimaryButtonStyle}" Click="Suspend_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
