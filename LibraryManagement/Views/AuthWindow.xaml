<Window x:Class="LibraryManagement.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auth="clr-namespace:LibraryManagement.Views.Auth"
        xmlns:vm="clr-namespace:LibraryManagement.ViewModels"
        Title="Library Management System"
        Width="1020"
        Height="640"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:AuthViewModel/>
    </Window.DataContext>

    <Grid x:Name="AuthCanvas"
          Background="{StaticResource CardBrush}"
          ClipToBounds="True"
          Focusable="True"
          SizeChanged="AuthCanvas_SizeChanged"
          PreviewMouseLeftButtonDown="AuthCanvas_PreviewMouseLeftButtonDown"
          PreviewMouseMove="AuthCanvas_PreviewMouseMove"
          PreviewMouseLeftButtonUp="AuthCanvas_PreviewMouseLeftButtonUp"
          LostMouseCapture="AuthCanvas_LostMouseCapture">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="BrandPanel"
                Grid.ColumnSpan="2"
                Width="360"
                HorizontalAlignment="Left"
                Panel.ZIndex="3"
                IsHitTestVisible="False"
                Background="{StaticResource SidebarBrush}"
                Padding="34,32">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BrandTransform"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="7"
                            Background="#082F49"
                            BorderBrush="#075985"
                            BorderThickness="1">
                        <Viewbox Margin="11">
                            <Path Data="M 13,0 L 3,13 L 9,13 L 7,24 L 19,9 L 12,9 Z"
                                  Fill="{StaticResource TechAccentCyan}"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LIBRARY.OS"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="SYSTEM CORE"
                                   Foreground="#38BDF8"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock FontSize="29"
                               LineHeight="35"
                               FontWeight="Bold"
                               Foreground="White">
                        <Run Text="Library"/><LineBreak/>
                        <Run Text="Management"/><LineBreak/>
                        <Run Text="System"/>
                    </TextBlock>

                    <TextBlock Text="Manage your library collection, circulation and readers from one secure workspace."
                               Foreground="#94A3B8"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               Margin="0,16,0,24"/>

                    <Border Height="1"
                            Background="#263449"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,22"/>

                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#38BDF8"
                                       VerticalAlignment="Top"
                                       Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Catalog Management" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Organize books and copies" Foreground="#94A3B8" FontSize="11.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE72A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#38BDF8"
                                       VerticalAlignment="Top"
                                       Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Borrow &amp; Return" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Track circulation easily" Foreground="#94A3B8" FontSize="11.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE716;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#38BDF8"
                                       VerticalAlignment="Top"
                                       Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Reader &amp; Fee Tracking" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Manage readers and fees" Foreground="#94A3B8" FontSize="11.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Library.OS" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Text="Internal Management System" Foreground="#64748B" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LoginPanel"
                Grid.ColumnSpan="2"
                Width="660"
                HorizontalAlignment="Left"
                Panel.ZIndex="1"
                Background="{StaticResource CardBrush}"
                IsEnabled="True"
                IsHitTestVisible="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LoginTransform"/>
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="42,24">
                    <auth:LoginView x:Name="LoginControl"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border x:Name="RegisterPanel"
                Grid.ColumnSpan="2"
                Width="660"
                HorizontalAlignment="Left"
                Panel.ZIndex="2"
                Background="{StaticResource CardBrush}"
                Opacity="0"
                IsEnabled="False"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RegisterTransform"/>
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="42,24">
                    <auth:RegisterView x:Name="RegisterControl"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
