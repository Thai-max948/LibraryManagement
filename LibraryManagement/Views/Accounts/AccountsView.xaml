<UserControl x:Class="LibraryManagement.Views.Accounts.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels">

    

    <StackPanel Margin="10">
        <!-- Title & Subtitle -->
        <TextBlock Text="👤 User Accounts" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Create, view, and manage authentication accounts and system roles" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

        <!-- Stat Cards Row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <!-- Total Accounts Card -->
            <Border Style="{StaticResource CardStyle}" Width="160" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalAccounts}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Total Accounts" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Admins Card -->
            <Border Style="{StaticResource CardStyle}" Width="160" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalAdmins}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TechAccentPurple}"/>
                    <TextBlock Text="Administrators" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Librarians Card -->
            <Border Style="{StaticResource CardStyle}" Width="160">
                <StackPanel>
                    <TextBlock Text="{Binding TotalLibrarians}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}"/>
                    <TextBlock Text="Librarians" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Search Box -->
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"
                 Tag="Search accounts by name, username, email, or role..."
                 Style="{StaticResource PlaceholderTextBoxStyle}"/>

        <!-- Toolbar Buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Create Account" Command="{Binding CreateAccountCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="✏ Edit Account" Command="{Binding EditAccountCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
            <Button Content="🗑 Delete Account" Command="{Binding DeleteAccountCommand}" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"/>
            <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Accounts Table -->
        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource AppDataGridStyle}" Height="370">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="180"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="130"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="130"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
