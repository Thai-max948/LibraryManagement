<Window x:Class="LibraryManagement.Views.Accounts.EditAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Account" Height="530" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Border Padding="24" Background="White" Margin="10" CornerRadius="10" BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#E0F2FE" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Edit Account" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Update user details, role assignment, or change password" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Full Name -->
                    <TextBlock Text="Full Name *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFullName" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="e.g. Sarah Connor" Margin="0,0,0,12"/>

                    <!-- Username & Role (2 columns) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Username *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtUsername" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="e.g. sarah" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="System Role *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbRole" Height="34" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Librarian"/>
                                <ComboBoxItem Content="Administrator"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Email Address -->
                    <TextBlock Text="Email Address *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="e.g. sarah@library.com" Margin="0,0,0,12"/>

                    <!-- New Password -->
                    <TextBlock Text="New Password (leave blank to keep current password)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtNewPassword" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm New Password" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtConfirmPassword" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Error feedback -->
                    <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" Width="90"/>
                <Button Content="💾 Save Changes" Click="BtnSave_Click" Style="{StaticResource PrimaryButtonStyle}" Width="130" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
