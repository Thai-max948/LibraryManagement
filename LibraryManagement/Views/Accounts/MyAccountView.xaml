<UserControl x:Class="LibraryManagement.Views.Accounts.MyAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="AccountBooleanToVisibilityConverter"/>

        <!-- Identity -->
        <Style x:Key="AccountAvatarStyle" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TechBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Account navigation -->
        <Style x:Key="AccountNavigationItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavigationItem"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationItem" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationItem" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="NavigationItem" Property="BorderBrush" Value="#BAE6FD"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Security inputs and visibility controls -->
        <Style x:Key="AccountPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7,42,7"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TechBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AccountVisiblePasswordStyle" TargetType="TextBox" BasedOn="{StaticResource PlaceholderTextBoxStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7,42,7"/>
        </Style>
        <Style x:Key="PasswordVisibilityButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeButton" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeButton" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EyeButton" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="EyeButton" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline result message -->
        <Style x:Key="AccountAlertBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TechBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="ProfileAlertBorderStyle" TargetType="Border" BasedOn="{StaticResource AccountAlertBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfileSuccess}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TechAccentGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProfileError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TechAccentRose}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PasswordAlertBorderStyle" TargetType="Border" BasedOn="{StaticResource AccountAlertBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPasswordSuccess}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TechAccentGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPasswordError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TechAccentRose}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileAlertTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfileSuccess}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TechAccentGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProfileError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TechAccentRose}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PasswordAlertTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPasswordSuccess}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TechAccentGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPasswordError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TechAccentRose}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="👤  My Account" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Manage your personal information and account security" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Identity summary -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AccountAvatarStyle}">
                    <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding IdentityLine}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,8,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource CardHoverBrush}" BorderBrush="{StaticResource TechBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Role}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Account navigation and section content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0" Padding="12" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="ACCOUNT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="10,6,10,12"/>
                    <RadioButton Content="Profile" GroupName="AccountSections" IsChecked="{Binding IsProfileSelected, Mode=OneWay}"
                                 Command="{Binding SelectProfileCommand}" Style="{StaticResource AccountNavigationItemStyle}"/>
                    <RadioButton Content="Security" GroupName="AccountSections" IsChecked="{Binding IsSecuritySelected, Mode=OneWay}"
                                 Command="{Binding SelectSecurityCommand}" Style="{StaticResource AccountNavigationItemStyle}"/>
                    <RadioButton Content="Access &amp; Role" GroupName="AccountSections" IsChecked="{Binding IsAccessRoleSelected, Mode=OneWay}"
                                 Command="{Binding SelectAccessRoleCommand}" Style="{StaticResource AccountNavigationItemStyle}"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="True" PanningMode="VerticalOnly">
                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="22" MinWidth="0">
                    <Grid>
                        <!-- Profile -->
                        <StackPanel Visibility="{Binding ProfileSectionVisibility}">
                            <TextBlock Text="PERSONAL INFORMATION" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Your account details" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,16"/>

                            <Border x:Name="ProfileAlertBox" Style="{StaticResource ProfileAlertBorderStyle}"
                                    Visibility="{Binding HasProfileMessage, Converter={StaticResource AccountBooleanToVisibilityConverter}}">
                                <TextBlock x:Name="TxtProfileAlert" Text="{Binding ProfileMessage}" Style="{StaticResource ProfileAlertTextStyle}"/>
                            </Border>

                            <StackPanel Visibility="{Binding ProfileSummaryVisibility}">
                                <Grid MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Full name" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,16"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FullName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="Username" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,16"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Username}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Text="Email" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,16"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Email}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="3" Text="Member since" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MemberSinceFormatted}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                </Grid>
                                <Button Content="Edit Profile" Command="{Binding ToggleEditProfileCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding EditProfileVisibility}" MaxWidth="680" HorizontalAlignment="Left">
                                <TextBlock Text="Full name" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Tag="Full name"
                                         Style="{StaticResource PlaceholderTextBoxStyle}" Height="38" Margin="0,0,0,14"/>
                                <TextBlock Text="Username" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}" Tag="Username"
                                         Style="{StaticResource PlaceholderTextBoxStyle}" Height="38" Margin="0,0,0,14"/>
                                <TextBlock Text="Email" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Tag="Email"
                                         Style="{StaticResource PlaceholderTextBoxStyle}" Height="38" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Content="Cancel" Command="{Binding CloseSidePanelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="Save Changes" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Security -->
                        <StackPanel Visibility="{Binding SecuritySectionVisibility}">
                            <TextBlock Text="SECURITY" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Keep your account secure by using a strong password." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,3,0,16"/>

                            <TextBlock Text="Current password" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,14">
                                <PasswordBox x:Name="PwdCurrent" Style="{StaticResource AccountPasswordBoxStyle}"/>
                                <TextBox x:Name="PwdCurrentVisible" Style="{StaticResource AccountVisiblePasswordStyle}" Visibility="Collapsed"/>
                                <TextBlock x:Name="PlaceholderPwdCurrent" Text="Current password" Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="10,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="BtnTogglePwdCurrent" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource PasswordVisibilityButtonStyle}" ToolTip="Show password"
                                        AutomationProperties.Name="Show or hide current password">
                                    <Path x:Name="IconPwdCurrentToggle" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" Width="17" Height="13" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="New password" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,14">
                                <PasswordBox x:Name="PwdNew" Style="{StaticResource AccountPasswordBoxStyle}"/>
                                <TextBox x:Name="PwdNewVisible" Style="{StaticResource AccountVisiblePasswordStyle}" Visibility="Collapsed"/>
                                <TextBlock x:Name="PlaceholderPwdNew" Text="New password" Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="10,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="BtnTogglePwdNew" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource PasswordVisibilityButtonStyle}" ToolTip="Show password"
                                        AutomationProperties.Name="Show or hide new password">
                                    <Path x:Name="IconPwdNewToggle" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" Width="17" Height="13" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Confirm new password" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,14">
                                <PasswordBox x:Name="PwdConfirm" Style="{StaticResource AccountPasswordBoxStyle}"/>
                                <TextBox x:Name="PwdConfirmVisible" Style="{StaticResource AccountVisiblePasswordStyle}" Visibility="Collapsed"/>
                                <TextBlock x:Name="PlaceholderPwdConfirm" Text="Confirm new password" Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="10,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="BtnTogglePwdConfirm" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource PasswordVisibilityButtonStyle}" ToolTip="Show password"
                                        AutomationProperties.Name="Show or hide confirm password">
                                    <Path x:Name="IconPwdConfirmToggle" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" Width="17" Height="13" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <Border x:Name="PasswordAlertBox" Style="{StaticResource PasswordAlertBorderStyle}"
                                    Visibility="{Binding HasPasswordMessage, Converter={StaticResource AccountBooleanToVisibilityConverter}}">
                                <TextBlock x:Name="TxtPasswordAlert" Text="{Binding PasswordMessage}" Style="{StaticResource PasswordAlertTextStyle}"/>
                            </Border>
                            <Border Background="{StaticResource CardHoverBrush}" BorderBrush="{StaticResource TechBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Password requirements" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="• At least 6 characters" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="Cancel" Click="BtnCancelPassword_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Change Password" Click="BtnChangePassword_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Access and role -->
                        <StackPanel Visibility="{Binding AccessRoleSectionVisibility}">
                            <TextBlock Text="ACCESS &amp; ROLE" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Your role and account permissions" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,16"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource CardHoverBrush}" BorderBrush="{StaticResource TechBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Role" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding Role}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource CardHoverBrush}" BorderBrush="{StaticResource TechBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Access level" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding AccessLevel}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Permissions" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Catalog management" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="✓" Foreground="{StaticResource TechAccentGreen}" FontWeight="Bold" HorizontalAlignment="Right"
                                           Visibility="{Binding CatalogCheckVisibility}"/>
                            </Grid>
                            <Separator Background="{StaticResource TechBorderBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Reader management" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="✓" Foreground="{StaticResource TechAccentGreen}" FontWeight="Bold" HorizontalAlignment="Right"
                                           Visibility="{Binding ReadersCheckVisibility}"/>
                            </Grid>
                            <Separator Background="{StaticResource TechBorderBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Circulation" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="✓" Foreground="{StaticResource TechAccentGreen}" FontWeight="Bold" HorizontalAlignment="Right"
                                           Visibility="{Binding CirculationCheckVisibility}"/>
                            </Grid>
                            <Separator Background="{StaticResource TechBorderBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Fees &amp; History" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="✓" Foreground="{StaticResource TechAccentGreen}" FontWeight="Bold" HorizontalAlignment="Right"
                                           Visibility="{Binding FeesHistoryCheckVisibility}"/>
                            </Grid>
                            <Separator Background="{StaticResource TechBorderBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <TextBlock Text="User account administration" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="✓" Foreground="{StaticResource TechAccentGreen}" FontWeight="Bold" HorizontalAlignment="Right"
                                           Visibility="{Binding UserAccountsCheckVisibility}"/>
                                <TextBlock Text="🔒" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"
                                           Visibility="{Binding UserAccountsLockVisibility}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
