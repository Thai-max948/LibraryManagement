<UserControl x:Class="LibraryManagement.Views.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource TechBorderBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Notifications" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Hoạt động gần đây" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button Content="✕" Command="{Binding CloseCenterCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" ToolTip="Đóng thông báo"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="All" Command="{Binding ShowAllCommand}" Padding="14,7" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsAllSelected}" Value="True"><Setter Property="Background" Value="#E0F2FE"/><Setter Property="Foreground" Value="#0369A1"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Unread" Command="{Binding ShowUnreadCommand}" Padding="14,7">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsUnreadSelected}" Value="True"><Setter Property="Background" Value="#E0F2FE"/><Setter Property="Foreground" Value="#0369A1"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{Binding LoadError}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,8"
                                        ToolTip="Đánh dấu đã đọc">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value><ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5F9"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate></Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Border Padding="11" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource TechBorderBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0F9FF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="True"><Setter Property="Background" Value="White"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="DueSoon"><Setter Property="Background" Value="#FFFBEB"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Foreground="{Binding AccentColor}" FontSize="16"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,5"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SourceModule}" Foreground="{StaticResource TechAccentCyan}" FontSize="11"/>
                                                    <TextBlock Text="  •  " Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding CreatedAtText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource TechAccentCyan}" VerticalAlignment="Top">
                                                <Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers><DataTrigger Binding="{Binding IsRead}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasVisibleNotifications}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="🔔" FontSize="30" HorizontalAlignment="Center"/>
                    <TextBlock Text="Không có thông báo" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                    <TextBlock Text="Các hoạt động mới trong hệ thống sẽ xuất hiện tại đây." TextWrapping="Wrap" TextAlignment="Center" Width="250" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                <Button Content="Mark all as read" Command="{Binding MarkAllAsReadCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
