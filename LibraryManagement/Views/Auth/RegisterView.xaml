<UserControl x:Class="LibraryManagement.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="420">

    <UserControl.Resources>
        <!-- Underline TextBox Style with Placeholder and Right Icon -->
        <Style x:Key="ModernUnderlineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="0,6,28,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="BottomLine"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="#94A3B8"
                                               FontSize="{TemplateBinding FontSize}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Right Circle Glyph -->
                            <Ellipse Width="12" Height="12"
                                     Stroke="#CBD5E1" StrokeThickness="1.5"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,6,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BottomLine" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="BottomLine" Property="BorderThickness" Value="0,0,0,1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Underline PasswordBox Style -->
        <Style x:Key="ModernUnderlinePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="0,6,36,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="BottomLine"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BottomLine" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="BottomLine" Property="BorderThickness" Value="0,0,0,1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Underline Password Visible TextBox Style -->
        <Style x:Key="ModernUnderlinePasswordVisibleTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="0,6,36,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="BottomLine"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BottomLine" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="BottomLine" Property="BorderThickness" Value="0,0,0,1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auth Eye Toggle Button Style -->
        <Style x:Key="ModernAuthEyeToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource PasswordEyeToggleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gradient Button Style -->
        <Style x:Key="ModernGradientButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="23">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#6366F1" Offset="0.0"/>
                                    <GradientStop Color="#2563EB" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#4F46E5" BlurRadius="18" Opacity="0.38" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="10,0">
        <StackPanel Width="340" HorizontalAlignment="Left">
            
            <!-- Top Right Security Badge -->
            <TextBlock Text="S E C U R E  •  U I"
                       Foreground="#94A3B8"
                       FontSize="9.5"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Margin="0,0,0,8"/>

            <!-- Title -->
            <TextBlock Text="Create account"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="0,0,0,22"/>

            <!-- Field 1: Full name -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Full name"
                           Foreground="#64748B"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtFullName"
                         Text="{Binding RegisterFullName, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Your name"
                         Style="{StaticResource ModernUnderlineTextBoxStyle}"/>
            </StackPanel>

            <!-- Field 2: Email address -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Email address"
                           Foreground="#64748B"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtEmail"
                         Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}"
                         Tag="name@bitsness.io"
                         Style="{StaticResource ModernUnderlineTextBoxStyle}"/>
            </StackPanel>

            <!-- Field 3: Password -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Password"
                           Foreground="#64748B"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Margin="0,0,0,4"/>
                <Grid>
                    <PasswordBox x:Name="TxtRegPassword"
                                 Style="{StaticResource ModernUnderlinePasswordBoxStyle}"/>
                    <TextBox x:Name="TxtRegPasswordVisible"
                             Visibility="Collapsed"
                             Style="{StaticResource ModernUnderlinePasswordVisibleTextBoxStyle}"/>
                    <TextBlock x:Name="PlaceholderPassword"
                               Text="At least 6 characters or more"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,6,36,8"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>
                    <Button x:Name="BtnToggleRegPassword"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,0,4"
                            Style="{StaticResource ModernAuthEyeToggleButtonStyle}"
                            ToolTip="Show password">
                        <Path x:Name="IconRegPasswordToggle"
                              Data="M 2,12 C 6,5 18,5 22,12 C 18,19 6,19 2,12 Z M 12,8.5 C 10.07,8.5 8.5,10.07 8.5,12 C 8.5,13.93 10.07,15.5 12,15.5 C 13.93,15.5 15.5,13.93 15.5,12 C 15.5,10.07 13.93,8.5 12,8.5 Z"
                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" Width="17" Height="13" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Action Button: Create account -->
            <Button x:Name="BtnRegister"
                    Content="Create account"
                    Click="BtnRegister_Click"
                    Style="{StaticResource ModernGradientButtonStyle}"/>

            <!-- Switch Mode Link -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="Already have an account? " Foreground="#94A3B8" FontSize="13"/>
                <Button x:Name="BtnGoToSignIn"
                        Click="BtnGoToSignIn_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="Sign in"
                                       Foreground="#6366F1"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Status / Alert message -->
            <Border x:Name="StatusCard"
                    Margin="0,12,0,0" Padding="10,6"
                    CornerRadius="6" Background="#FEF2F2"
                    BorderBrush="#FCA5A5" BorderThickness="1"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtStatus"
                           Text="{Binding StatusMessage}"
                           Foreground="#DC2626"
                           FontSize="11.5"
                           TextAlignment="Center"/>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
