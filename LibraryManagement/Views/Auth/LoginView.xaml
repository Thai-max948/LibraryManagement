<UserControl x:Class="LibraryManagement.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="420">

    <UserControl.Resources>
        <!-- Underline TextBox Style with Placeholder and Right Icon -->
        <Style x:Key="ModernUnderlineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="0,6,28,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="BottomLine"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="#94A3B8"
                                               FontSize="{TemplateBinding FontSize}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Right Circle Glyph -->
                            <Ellipse Width="12" Height="12"
                                     Stroke="#CBD5E1" StrokeThickness="1.5"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,6,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BottomLine" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="BottomLine" Property="BorderThickness" Value="0,0,0,1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Underline PasswordBox Style -->
        <Style x:Key="ModernUnderlinePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="0,6,28,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="BottomLine"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>

                            <!-- Right Circle Glyph -->
                            <Ellipse Width="12" Height="12"
                                     Stroke="#CBD5E1" StrokeThickness="1.5"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,6,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BottomLine" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="BottomLine" Property="BorderThickness" Value="0,0,0,1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Accent CheckBox -->
        <Style x:Key="ModernAccentCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16"
                                    CornerRadius="4"
                                    BorderBrush="#CBD5E1" BorderThickness="1.5"
                                    Background="White"
                                    Margin="0,0,8,0">
                                <Path x:Name="CheckMark"
                                      Data="M 3,8 L 6,11 L 12,4"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gradient Button Style -->
        <Style x:Key="ModernGradientButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="23">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#6366F1" Offset="0.0"/>
                                    <GradientStop Color="#2563EB" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#4F46E5" BlurRadius="18" Opacity="0.38" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="10,0">
        <StackPanel Width="340" HorizontalAlignment="Left">
            
            <!-- Title -->
            <TextBlock Text="Sign in"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="0,0,0,26"/>

            <!-- Field 1: Username or email -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Username or email"
                           Foreground="#64748B"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUsernameOrEmail"
                         Text="{Binding SignInEmailOrUsername, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernUnderlineTextBoxStyle}"/>
            </StackPanel>

            <!-- Field 2: Password -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Password"
                           Foreground="#64748B"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Margin="0,0,0,4"/>
                <Grid>
                    <PasswordBox x:Name="TxtPassword"
                                 PasswordChanged="TxtPassword_PasswordChanged"
                                 Style="{StaticResource ModernUnderlinePasswordBoxStyle}"/>
                    <TextBlock x:Name="PlaceholderPassword"
                               Text="••••••••"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,6,28,8"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>
                </Grid>
            </StackPanel>

            <!-- Row 3: Keep me signed in & Forgot password -->
            <Grid Margin="0,4,0,24">
                <CheckBox Content="Keep me signed in"
                          IsChecked="{Binding RememberMe}"
                          Style="{StaticResource ModernAccentCheckBoxStyle}"
                          HorizontalAlignment="Left"/>

                <Button Content="Forgot password?"
                        Command="{Binding ForgotPasswordCommand}"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#6366F1"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Action Button: Sign in -->
            <Button x:Name="BtnSignIn"
                    Content="Sign in"
                    Click="BtnSignIn_Click"
                    Style="{StaticResource ModernGradientButtonStyle}"/>

            <!-- Switch Mode Link -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Text="New to Bitsness? " Foreground="#94A3B8" FontSize="13"/>
                <Button x:Name="BtnGoToRegister"
                        Click="BtnGoToRegister_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="Create an account"
                                       Foreground="#6366F1"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Status / Alert message -->
            <Border x:Name="StatusCard"
                    Margin="0,14,0,0" Padding="10,6"
                    CornerRadius="6" Background="#FEF2F2"
                    BorderBrush="#FCA5A5" BorderThickness="1"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtStatus"
                           Text="{Binding StatusMessage}"
                           Foreground="#DC2626"
                           FontSize="11.5"
                           TextAlignment="Center"/>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
