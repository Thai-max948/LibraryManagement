<UserControl x:Class="LibraryManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="DashboardPanelCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="DashboardKpiCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="104"/>
        </Style>

        <Style x:Key="DashboardAttentionCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="82"/>
        </Style>

        <Style x:Key="DashboardGridCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <Grid Margin="4,0,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,4,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="LIBRARY DASHBOARD"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Operational overview"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource TechBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Last updated"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding LastUpdatedText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2"
                            Content="{Binding RefreshButtonText}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="10,0,0,0"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>

                <!-- Core operational metrics. -->
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,18">
                    <Border Style="{StaticResource DashboardKpiCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="{StaticResource TechAccentPurple}" CornerRadius="2" Margin="0,2,12,2"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="ACTIVE READERS"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ActiveReaders, TargetNullValue=—}"
                                       FontSize="25" FontWeight="Bold" Foreground="{StaticResource TechAccentPurple}"
                                       Margin="0,5,0,1"/>
                            <TextBlock Grid.Column="1" Grid.Row="2" Text="Active, non-deleted readers"
                                       FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="{StaticResource TechAccentGreen}" CornerRadius="2" Margin="0,2,12,2"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="AVAILABLE"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding AvailableCopies, TargetNullValue=—}"
                                       FontSize="25" FontWeight="Bold" Foreground="{StaticResource TechAccentGreen}"
                                       Margin="0,5,0,1"/>
                            <TextBlock Grid.Column="1" Grid.Row="2" Text="Verified copies on active titles"
                                       FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="{StaticResource TechAccentCyan}" CornerRadius="2" Margin="0,2,12,2"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="ACTIVE LOANS"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ActiveLoans, TargetNullValue=—}"
                                       FontSize="25" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}"
                                       Margin="0,5,0,1"/>
                            <TextBlock Grid.Column="1" Grid.Row="2" Text="Open borrow records"
                                       FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="{StaticResource TechAccentRose}" CornerRadius="2" Margin="0,2,12,2"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="OVERDUE"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding OverdueLoans, TargetNullValue=—}"
                                       FontSize="25" FontWeight="Bold" Foreground="{StaticResource TechAccentRose}"
                                       Margin="0,5,0,1"/>
                            <TextBlock Grid.Column="1" Grid.Row="2" Text="Loans past due date"
                                       FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="{StaticResource TechAccentAmber}" CornerRadius="2" Margin="0,2,12,2"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="TOTAL INVENTORY"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding TotalCopies, TargetNullValue=—}"
                                       FontSize="25" FontWeight="Bold" Foreground="{StaticResource TechAccentAmber}"
                                       Margin="0,5,0,1"/>
                            <TextBlock Grid.Column="1" Grid.Row="2" Text="Physical copies in system"
                                       FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Attention Required -->
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="ATTENTION REQUIRED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Items that may need librarian action" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4">
                        <Border Style="{StaticResource DashboardAttentionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource TechAccentRose}" CornerRadius="2" Margin="0,2,10,2"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="OVERDUE LOANS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OverdueLoans, TargetNullValue=—}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TechAccentRose}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DashboardAttentionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource TechAccentAmber}" CornerRadius="2" Margin="0,2,10,2"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DUE SOON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DueSoonLoans, TargetNullValue=—}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TechAccentAmber}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DashboardAttentionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource TechAccentPurple}" CornerRadius="2" Margin="0,2,10,2"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DAMAGED / REPAIR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DamagedOrRepairCopies, TargetNullValue=—}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TechAccentPurple}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DashboardAttentionCardStyle}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource TechAccentCyan}" CornerRadius="2" Margin="0,2,10,2"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="OUTSTANDING FEES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OutstandingFeesText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- Inventory Health and Circulation Activity -->
                <Grid Grid.Row="3" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardPanelCardStyle}" Margin="0,0,7,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="INVENTORY HEALTH" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Physical copy overview" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,4,0,7">
                                    <TextBlock Text="Available" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding AvailableCopies, TargetNullValue=—}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TechAccentGreen}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Grid.Row="1" Height="1" Background="{StaticResource TechBorderBrush}"/>

                                <Grid Grid.Row="2" Margin="0,7,0,7">
                                    <TextBlock Text="Borrowed" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding BorrowedCopies, TargetNullValue=—}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Grid.Row="3" Height="1" Background="{StaticResource TechBorderBrush}"/>

                                <Grid Grid.Row="4" Margin="0,7,0,7">
                                    <TextBlock Text="Damaged / Under Repair" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DamagedOrRepairCopies, TargetNullValue=—}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TechAccentPurple}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Grid.Row="5" Height="1" Background="{StaticResource TechBorderBrush}"/>

                                <Grid Grid.Row="6" Margin="0,7,0,7">
                                    <TextBlock Text="Lost" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding LostCopies, TargetNullValue=—}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TechAccentRose}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Grid.Row="7" Height="1" Background="{StaticResource TechBorderBrush}"/>

                                <Grid Grid.Row="8" Margin="0,7,0,4">
                                    <TextBlock Text="Retired" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding RetiredCopies, TargetNullValue=—}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DashboardPanelCardStyle}" Margin="7,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="CIRCULATION — LAST 7 DAYS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="Borrow and return activity" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource TechBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" MinHeight="154" Margin="0,12,0,0" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="BORROW" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}"/>
                                        <TextBlock Grid.Column="2" Text="RETURN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TechAccentPurple}"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ItemsControl ItemsSource="{Binding Circulation}" Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="24"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DayLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                            <TextBlock Text="{Binding DateLabel}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                        <ProgressBar Grid.Column="1" Value="{Binding BorrowCount}" Maximum="{Binding DataContext.CirculationMaximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                     Height="8" VerticalAlignment="Center" Foreground="{StaticResource TechAccentCyan}" Background="{StaticResource TechBorderBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding BorrowCount}" FontSize="9" Foreground="{StaticResource TextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="3" Value="{Binding ReturnCount}" Maximum="{Binding DataContext.CirculationMaximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                     Height="8" VerticalAlignment="Center" Foreground="{StaticResource TechAccentPurple}" Background="{StaticResource TechBorderBrush}" Margin="4,0,0,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ReturnCount}" FontSize="9" Foreground="{StaticResource TextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding DashboardLoadMessage}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="{Binding HasLoaded, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Recent Activity -->
                <Grid Grid.Row="4" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardPanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="RECENT BORROWS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Latest borrowing records" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <DataGrid ItemsSource="{Binding RecentBorrowings}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" RowHeaderWidth="0"
                                          ColumnHeaderHeight="36" Height="224"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource AppDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="READER" Binding="{Binding ReaderName}" Width="1.05*" ElementStyle="{StaticResource DashboardGridCellTextStyle}"/>
                                        <DataGridTextColumn Header="BOOK" Binding="{Binding BookTitle}" Width="1.55*" ElementStyle="{StaticResource DashboardGridCellTextStyle}"/>
                                        <DataGridTextColumn Header="BORROW DATE" Binding="{Binding BorrowDateText}" Width="94" ElementStyle="{StaticResource DashboardGridCellTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource TechBorderBrush}"
                                        BorderThickness="1" Margin="1,37,1,1" Padding="14"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentBorrowings.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasLoaded}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RecentBorrowingsEmptyMessage}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardPanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="RECENT RETURNS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Latest completed returns" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <DataGrid ItemsSource="{Binding RecentReturnings}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" RowHeaderWidth="0"
                                          ColumnHeaderHeight="36" Height="224"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource AppDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="READER" Binding="{Binding ReaderName}" Width="1.05*" ElementStyle="{StaticResource DashboardGridCellTextStyle}"/>
                                        <DataGridTextColumn Header="BOOK" Binding="{Binding BookTitle}" Width="1.55*" ElementStyle="{StaticResource DashboardGridCellTextStyle}"/>
                                        <DataGridTextColumn Header="RETURN DATE" Binding="{Binding ReturnDateText}" Width="94" ElementStyle="{StaticResource DashboardGridCellTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource TechBorderBrush}"
                                        BorderThickness="1" Margin="1,37,1,1" Padding="14"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentReturnings.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasLoaded}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RecentReturningsEmptyMessage}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
