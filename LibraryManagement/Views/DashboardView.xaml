<UserControl x:Class="LibraryManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <StackPanel Margin="10">
        <TextBlock Text="📊 Library Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>

        <UniformGrid Columns="5" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalBooks}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Total Books" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalReaders}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Total Readers" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding AvailableBooks}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Available Books" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentlyBorrowed}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Currently Borrowed" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding OverdueBooks}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="Overdue Books" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="Recent Borrowings" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
        <DataGrid ItemsSource="{Binding RecentBorrowings}" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource AppDataGridStyle}" Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reader" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Book" Binding="{Binding BookTitle}" Width="*"/>
                <DataGridTextColumn Header="Borrow Date" Binding="{Binding BorrowDate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Recent Returnings" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
        <DataGrid ItemsSource="{Binding RecentReturnings}" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource AppDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reader" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Book" Binding="{Binding BookTitle}" Width="*"/>
                <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>