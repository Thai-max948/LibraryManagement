<UserControl x:Class="LibraryManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryManagement.ViewModels">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="*"/>    <!-- Activity Feeds -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Grid Grid.Row="0" Margin="4,0,4,18">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SYSTEM DASHBOARD" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text=" // METRICS" FontSize="13" Foreground="{StaticResource TechAccentCyan}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,2,0,0"/>
                </StackPanel>
                <TextBlock Text="Real-time catalog metrics and circulation overview" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Live Status Pill (Crisp White with Cyan Tech Glow) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1"
                    CornerRadius="14" Padding="12,5">
                <Border.Effect>
                    <DropShadowEffect Color="#0284C7" Opacity="0.12" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource TechAccentCyan}" Margin="0,0,8,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.35" Duration="0:0:1.2"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="SYSTEM ONLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. KPI Cards Row (5 metrics on Crisp White) -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <!-- Total Books -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="TOTAL INVENTORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#E0F2FE" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="📚" FontSize="12"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding TotalBooks}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}" Margin="0,8,0,2"/>
                    <TextBlock Grid.Row="2" Text="Total physical items" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                </Grid>
            </Border>

            <!-- Total Readers -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="ACTIVE MEMBERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#EEF2FF" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="👥" FontSize="12"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding TotalReaders}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TechAccentPurple}" Margin="0,8,0,2"/>
                    <TextBlock Grid.Row="2" Text="Registered readers" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                </Grid>
            </Border>

            <!-- Available Books -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="AVAILABLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TechAccentGreen}"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding AvailableBooks}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TechAccentGreen}" Margin="0,8,0,2"/>
                    <TextBlock Grid.Row="2" Text="Ready on shelf" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                </Grid>
            </Border>

            <!-- Currently Borrowed -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="ON LOAN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#FEF3C7" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="📖" FontSize="12"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding CurrentlyBorrowed}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TechAccentAmber}" Margin="0,8,0,2"/>
                    <TextBlock Grid.Row="2" Text="Active borrowings" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                </Grid>
            </Border>

            <!-- Overdue Books -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="OVERDUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#FFE4E6" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="⚠" FontSize="11" Foreground="{StaticResource TechAccentRose}" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding OverdueBooks}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TechAccentRose}" Margin="0,8,0,2"/>
                    <TextBlock Grid.Row="2" Text="Requires attention" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- 3. Side-by-Side Activity Grids -->
        <Grid Grid.Row="2" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Borrowings Feed -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RECENT BORROWINGS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <Border Background="#E0F2FE" CornerRadius="4" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE LOANS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TechAccentCyan}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentBorrowings}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="READER" Binding="{Binding ReaderName}" Width="*"/>
                            <DataGridTextColumn Header="BOOK" Binding="{Binding BookTitle}" Width="1.3*"/>
                            <DataGridTextColumn Header="BORROW DATE" Binding="{Binding BorrowDate}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Recent Returnings Feed -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RECENT RETURNS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TechAccentGreen}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentReturnings}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="READER" Binding="{Binding ReaderName}" Width="*"/>
                            <DataGridTextColumn Header="BOOK" Binding="{Binding BookTitle}" Width="1.3*"/>
                            <DataGridTextColumn Header="RETURN DATE" Binding="{Binding ReturnDate}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>